# QA Workbench ML service configuration (all optional).

# Where the trained model artifact lives.
# QA_ML_MODEL_PATH=models/quality_model.joblib

# Cosine-similarity cutoff for duplicate detection (0..1).
# QA_ML_DUP_THRESHOLD=0.75

# Blend weight: 0 = pure heuristic, 1 = pure ML model.
# QA_ML_MODEL_ALPHA=0.5

# HTTP port when running via `python -m app.main`.
# QA_ML_PORT=8000

# Train a model on startup if none is found on disk (1/0).
# QA_ML_AUTO_TRAIN=1
