# Official OpenAI API (https://platform.openai.com/) — vision models e.g. gpt-4o
OPENAI_API_KEY=

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=

# When both keys are set: openai | gemini | auto (auto prefers OpenAI unless you override in UI)
AI_PROVIDER=auto

PORT=3847

# Optional overrides
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.0-flash
