# Official OpenAI API (https://platform.openai.com/) — vision models e.g. gpt-4o
OPENAI_API_KEY=

# Groq OpenAI-compatible API (https://console.groq.com/)
GROQ_API_KEY=

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=

# openai | groq | gemini | auto — auto picks first available: OpenAI, then Groq, then Gemini
AI_PROVIDER=auto

PORT=3847

# Optional overrides
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# If unset: text-only uses llama-3.3-70b-versatile; with screenshots uses llama-3.2-11b-vision-preview unless GROQ_MODEL is set
# GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
